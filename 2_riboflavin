# ============================
# STEP 1: LASSO implememtation
# ============================

def compute_loss(X, y, x_weights):
    """
    Compute the value of the objective function (Least Squares).
    Parameters:
    X : numpy array of shape (n_samples, n_features)
    y : numpy array of shape (n_samples,)
    x_weights : numpy array of shape (n_features,) - current coefficients
    Returns:
    loss : float
    """
    # (X * x) - y
    residual = (X @ x_weights) - y
    
    # 0.5 * L2_norm_squared
    loss = 0.5 * np.sum(residual ** 2)
    return loss

def compute_gradient(X, y, x_weights):
    """
    Compute the gradient vector of the objective function.
    
    Parameters:
    X : numpy array of shape (n_samples, n_features)
    y : numpy array of shape (n_samples,)
    x_weights : numpy array of shape (n_features,) - current coefficients
    
    Returns:
    grad : numpy array of shape (n_features,)
    """
    # (X * x) - y
    residual = (X @ x_weights) - y
    
    # Gradient: X_transposed multiplied by the residual
    grad = X.T @ residual
    return grad

# ===============================================
# STEP 2: Frank_Wolfe and variants implementation
# ===============================================

# 1. linear minimization oracle for L1 ball
def lmo_l1(gradient, tau):
    """
    Linear Minimization Oracle (LMO) for ball L1.
    Find the optimal atom/vertex s_t to minimize the dot product with gradient.
    """
    # s = zero vector of the same shape as gradient
    s = np.zeros_like(gradient)

    # find the index of the feature with the maximum absolute gradient
    idx_max = np.argmax(np.abs(gradient))

    # we assign the value tau to that index, with the OPPOSITE sign of the gradient to point in the 
    # direction of steepest descent
    s[idx_max] = -np.sign(gradient[idx_max]) * tau
    
    return s

# 2. standard FW for LASSO
def frank_wolfe_lasso(X, y, tau, max_iter=1000, tol=1e-4):
    """
    Standard Frank-Wolfe algorithm for the LASSO problem.
    """
    n_samples, n_features = X.shape
    # we start wiht the center of the L1 ball is the zero vector, 
    # which is also the point of maximum sparsity
    x_t = np.zeros(n_features) 

    history_loss, history_gap, history_time, history_sparsity = [], [], [], []
    t0 = time()
    
    for t in range(max_iter):
        # 1. current gradient computation
        grad = compute_gradient(X, y, x_t)
        
        # 2. oracle call (find the vertex s_t)
        s_t = lmo_l1(grad, tau)
        
        # 3. update direction
        d_t = s_t - x_t
        
        # 4. Compute the Frank-Wolfe Duality Gap
        # formula: <grad, x_t - s_t> che equivale a <grad, -d_t>
        gap = np.dot(grad, -d_t)
        
        # Save the metrics for the final plots
        history_loss.append(compute_loss(X, y, x_t))
        history_gap.append(gap)
        history_time.append(time() - t0)
        history_sparsity.append(np.sum(np.abs(x_t) > 1e-8))
        
        # 5. Stopping criterion: if the gap is smaller than the tolerance, we stop
        if gap <= tol:
            print(f"Convergenza raggiunta all'iterazione {t} con gap: {gap:.6f}")
            break
            
        # 6. Exact Line Search
        # Find the optimal step size gamma by minimizing analytically the parabola
        Xd = X @ d_t
        # to avoid division by zero
        gamma_ottimale = gap / (np.sum(Xd ** 2) + 1e-10) 
        gamma = np.clip(gamma_ottimale, 0.0, 1.0)
        
        # 7. Update the coefficients
        x_t = x_t + gamma * d_t
        
    return x_t, history_loss, history_gap, history_time, history_sparsity


# 3. Away-step Frank-Wolfe for LASSO
def away_steps_fw_lasso(X, y, tau, max_iters=1000, tolerance=1e-4):
    n_samples, n_features = X.shape
    x = np.zeros(n_features)

    grad_0 = compute_gradient(X, y, x)
    start_idx = np.argmax(np.abs(grad_0))
    start_sign = -np.sign(grad_0[start_idx])

    x[start_idx] = start_sign * tau

    # Active Set (dict: key = index, value = sign)
    weights = {(start_idx, start_sign): 1.0}

    history_loss, history_gap, history_time, history_sparsity = [], [], [], []
    t0 = time()

    for k in range(max_iters):
        grad = compute_gradient(X, y, x)

        # FW VERTEX
        s_idx = np.argmax(np.abs(grad))
        s_sign = -np.sign(grad[s_idx])
        s_vec = np.zeros(n_features)
        s_vec[s_idx] = s_sign * tau

        # AWAY VERTEX 
        max_val = -np.inf
        v_key = None
        for key in weights.keys():
            idx, sign = key
            val = grad[idx] * sign * tau
            if val > max_val:
                max_val = val
                v_key = key

        v_vec = np.zeros(n_features)
        v_idx, v_sign = v_key
        v_vec[v_idx] = v_sign * tau

        # STOPPING CONDITION
        fw_gap = -np.dot(grad, s_vec - x)

        history_loss.append(compute_loss(X, y, x))
        history_gap.append(fw_gap)
        history_time.append(time() - t0)            
        history_sparsity.append(np.sum(np.abs(x) > 1e-8))

        if fw_gap <= tolerance:
            print(f"AFW Convergenza raggiunta all'iterazione {k} con gap: {fw_gap:.6f}")
            break

        # direction and overflow protection
        away_gap = -np.dot(grad, x - v_vec)

        # protection: if there is only one vertex, or if the FW gap is larger, take FW step
        if len(weights) == 1 or fw_gap >= away_gap:
            direction = s_vec - x
            alpha_max = 1.0
            is_fw_step = True
        else:
            direction = x - v_vec
            current_weight = weights[v_key]

            denom = max(1.0 - current_weight, 1e-12)
            alpha_max = current_weight / denom
            is_fw_step = False

        # EXACT LINE SEARCH
        if np.max(np.abs(direction)) < 1e-14:
            alpha = 0.0
        else:
            Xd = X @ direction
            den = np.sum(Xd ** 2)
            if den < 1e-10:
                alpha = 0.0
            else:
                opt_alpha = -np.dot(grad, direction) / den
                alpha = np.clip(opt_alpha, 0.0, alpha_max)

        # UPDATE x
        x = x + alpha * direction

        # UPDATE ACTIVE SET
        if is_fw_step:
            for key in list(weights.keys()):
                weights[key] = (1 - alpha) * weights[key]
            s_key = (s_idx, s_sign)
            weights[s_key] = weights.get(s_key, 0.0) + alpha
        else:
            for key in list(weights.keys()):
                if key == v_key:
                    weights[key] = (1 + alpha) * weights[key] - alpha
                else:
                    weights[key] = (1 + alpha) * weights[key]

        # DROP STEP
        keys_to_drop = [key for key, val in weights.items() if val < 1e-9]
        for key in keys_to_drop:
            del weights[key]

    # final normalization of weights to ensure they sum to 1 
    sum_weights = sum(weights.values())
    for key in weights.keys():
        weights[key] /= sum_weights

    cpu_time = time() - t0
    return x, history_loss, history_gap, history_time, history_sparsity


# 4. Pairwise Frank-Wolfe for LASSO
def pairwise_fw_lasso(X, y, tau, max_iters=1000, tolerance=1e-4):
    """
    Pairwise Frank-Wolfe optimized with dictionary for the LASSO problem.
    """
    n_samples, n_features = X.shape
    x = np.zeros(n_features)
    
    # Initialize the active set with the first vertex
    grad_0 = compute_gradient(X, y, x)
    start_idx = np.argmax(np.abs(grad_0))
    start_sign = -np.sign(grad_0[start_idx])
    
    x[start_idx] = start_sign * tau
    weights = {(start_idx, start_sign): 1.0} 

    history_loss, history_gap, history_time, history_sparsity = [], [], [], []
    t0 = time()

    for k in range(max_iters):
        # 1. NORMALIZATION OF WEIGHTS 
        sum_weights = sum(weights.values())
        for key in weights.keys():
            weights[key] /= sum_weights

        grad = compute_gradient(X, y, x)

        # 2. FW VERTEX (s_t) 
        s_idx = np.argmax(np.abs(grad))
        s_sign = -np.sign(grad[s_idx])
        s_vec = np.zeros(n_features)
        s_vec[s_idx] = s_sign * tau
        s_key = (s_idx, s_sign)

        # 3. AWAY VERTEX (v_t)
        max_val = -np.inf
        v_key = None
        for key in weights.keys():
            idx, sign = key
            val = grad[idx] * sign * tau 
            if val > max_val:
                max_val = val
                v_key = key
                
        v_vec = np.zeros(n_features)
        v_idx, v_sign = v_key
        v_vec[v_idx] = v_sign * tau

        # 4. STOPPING CONDITION
        fw_gap = -np.dot(grad, s_vec - x)
        history_loss.append(compute_loss(X, y, x))
        history_gap.append(fw_gap)
        history_time.append(time() - t0)
        history_sparsity.append(np.sum(np.abs(x) > 1e-8))

        if fw_gap <= tolerance:
            print(f"PFW convergence obtained at iteration {k} with gap: {fw_gap:.6f}")
            break

        # 5. PAIRWISE DIRECTION
        # direct transfer of mass from the worst vertex (v_vec) to the best vertex (s_vec)
        direction = s_vec - v_vec

        # the stability of PFW: the maximum step size is simply the weight of the Away vertex
        alpha_max = weights[v_key]

        # 6. EXACT LINE SEARCH
        Xd = X @ direction
        den = np.sum(Xd ** 2)
        if den < 1e-10:
            alpha = 0.0
        else:
            opt_alpha = -np.dot(grad, direction) / den
            alpha = np.clip(opt_alpha, 0.0, alpha_max)

        # 7. UPDATE x
        x = x + alpha * direction

        # 8. UPDATE ACTIVE SET
        # We update the weights of the active set. The weight of the Away vertex decreases,
        # while the weight of the FW vertex increases.
        weights[v_key] -= alpha
        weights[s_key] = weights.get(s_key, 0.0) + alpha

        # 9. DROP STEP
        keys_to_drop = [key for key, val in weights.items() if val < 1e-9]
        for key in keys_to_drop:
            del weights[key]

    cpu_time = time() - t0
    return x, history_loss, history_gap, history_time, history_sparsity

