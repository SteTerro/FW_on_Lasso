# STEP 3: load the dataset from local csv file
# =============================================

"""
About the dataset:
The Riboflavin dataset comes from a real-world experiment on Bacillus subtilis (a bacterium) used to 
produce riboflavin (vitamin B2) on an industrial scale.

X (the features, p=4088): expression level (log-transformed) of 4088 bacterial genes, 
measured by microarray, for 71 different cultures.
y (the target): the riboflavin production rate (log-transformed) obtained from each culture.

Assuming we work for a biotechnology company, our goal will be to identify which of these genes influence 
production yield, so that we can then genetically intervene on those specific genes and increase 
the industrial production of riboflavin.
"""

print("1. Loading Riboflavin dataset...")

# 1. READ THE DATASET
file_name = 'riboflavin.csv' 
df = pd.read_csv(file_name)

# 2. X AND Y SEPARATION 
target_col = 'y' 

y = df[target_col].values
X = df.drop(columns=[target_col]).values

print(f"Dataset dimensions: {X.shape[0]} observations, {X.shape[1]} features (genes)")

# 3. STANDARDIZATION OF X AND Y
print("\n2. Standardizing X and y...")
scaler_X = StandardScaler()
X_scaled = scaler_X.fit_transform(X)

scaler_y = StandardScaler()
# reshape(-1, 1) is necessary to standardize a 1D vector with sklearn
y_scaled = scaler_y.fit_transform(y.reshape(-1, 1)).flatten() 

# 4. TUNING THE TAU PARAMETER
# Since this is a very different dataset (thousands of genes), we start with an intermediate radius
tau_param = 1.0  

# Calcolo baseline (loss con tutti i pesi a zero)
zero_weights = np.zeros(X_scaled.shape[1])
baseline_loss = compute_loss(X_scaled, y_scaled, zero_weights)
print(f"\n---> INITIAL LOSS (Baseline with zero weights): {baseline_loss:.4f} <---")
print(f"---> L1 Radius (Tau) set to: {tau_param} <---")

# 5. ALGORITHMS EXECUTION
print("\n3. Standard Frank-Wolfe execution...")
weights_fw, loss_fw, gap_fw, time_fw, spars_fw = frank_wolfe_lasso(X_scaled, y_scaled, tau=tau_param)
fw_non_zero_weights = np.sum(np.abs(weights_fw) > 1e-8)

print("\n4. Away-Step Frank-Wolfe (AFW) execution...")
weights_afw, loss_afw, gap_afw, time_afw, spars_afw = away_steps_fw_lasso(X_scaled, y_scaled, tau=tau_param)
afw_non_zero_weights = np.sum(np.abs(weights_afw) > 1e-8)

print("\n5. Pairwise Frank-Wolfe (PFW) execution...")
weights_pfw, loss_pfw, gap_pfw, time_pfw, spars_pfw = pairwise_fw_lasso(X_scaled, y_scaled, tau=tau_param)
pfw_non_zero_weights = np.sum(np.abs(weights_pfw) > 1e-8)

# 6. RESULTS SUMMARY
print("\n--- STANDARD FW RESULTS ---")
print(f"Initial loss (after 1st vertex): {loss_fw[0]:.4f}")
print(f"Final loss: {loss_fw[-1]:.4f}")
print(f"Final gap: {gap_fw[-1]:.6f}")
print(f"Selected features: {fw_non_zero_weights} out of {X_scaled.shape[1]}")

print("\n--- AFW RESULTS ---")
print(f"Initial loss (after 1st vertex): {loss_afw[0]:.4f}")
print(f"Final loss: {loss_afw[-1]:.4f}")
print(f"Final gap: {gap_afw[-1]:.6f}")
print(f"Selected features: {afw_non_zero_weights} out of {X_scaled.shape[1]}")

print("\n--- PFW RESULTS ---")
print(f"Initial loss (after 1st vertex): {loss_pfw[0]:.4f}")
print(f"Final loss: {loss_pfw[-1]:.4f}")
print(f"Final gap: {gap_pfw[-1]:.6f}")
print(f"Selected features: {pfw_non_zero_weights} out of {X_scaled.shape[1]}")


# =============
